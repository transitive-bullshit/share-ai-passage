# The app uses Portless in development and Vercel's deployment URLs when hosted.
# Direct local and Docker runs use localhost (port 3000 unless PORT is set).
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/ai_chat_proxy
# Optional direct connection for migrations; runtime uses DATABASE_URL (pooled).
# Neon's DATABASE_URL_UNPOOLED is also accepted by the migration config.
# DIRECT_DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for production. Keep stable: changing it expires prepared previews.
APP_SECRET=

# Daily private cleanup: exact bearer secret for /api/cron/cleanup-assets.
# Vercel schedules run only on production deployments; use a random server-only value.
CRON_SECRET=

# Empty: automatically trust Vercel's own header on Vercel; shared local budget otherwise.
# none: explicitly use one shared budget; never trust forwarded client headers.
# vercel: trust Vercel's overwritten client header only when VERCEL=1.
# single: trust X-Real-IP only behind a proxy that overwrites it.
TRUST_PROXY=

# Required preview generation: the server sends bounded public conversation text to OpenAI.
# Explicit retries recover an existing operation; uncertain work is never silently redispatched.
# Metered model overrides require a supported cost bound; keep this default for accounts.
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-nano
OPENAI_API_KEY=
# Optional shared monthly summary budget, including paid accounts. Preview uses $1.
# Empty preserves the default Free budget and paid per-account spending protection.
SUMMARY_AI_MONTHLY_BUDGET_USD=

# PostgreSQL binaries for the optional native local database helper.
# PG_BIN=/Applications/Postgres.app/Contents/Versions/latest/bin

# Integration tests are skipped unless this is set. Use a disposable database.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/ai_chat_proxy

# Accounts: defaults use APP_SECRET and the resolved application origin.
# Keep the auth secret stable; rotating it invalidates sessions.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Use separate development and production OAuth apps/projects.
# Development Google sign-in uses owned-domain HTTPS; see docs/PRODUCTION.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Conversation images use the same R2 storage configuration as account assets.
# Read/write credentials scoped to these separate buckets; no public image URLs
# are stored in snapshots. Imported media is delivered through its passage.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_API_ENDPOINT=
S3_BUCKET_NAME=
S3_PRIVATE_BUCKET_NAME=
S3_PUBLIC_URL=
# R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ENDPOINT, R2_PUBLIC_BUCKET,
# R2_PRIVATE_BUCKET and R2_PUBLIC_URL are supported aliases with precedence.
# R2_ACCOUNT_ID is optional when encoded in S3_API_ENDPOINT.

# Email/password signup and recovery use the verified accounts sending domain.
# Use a separate Sending-access key restricted to this domain per environment.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Passage <hello@accounts.share-ai-passage.com>"
# Optional reply address for account messages.
RESEND_REPLY_TO="passage@transitivebullsh.it"

# Paid plans: separate Stripe sandbox/live credentials and prices per environment.
# Test checkout works when configured. Keep live checkout disabled until Gate B.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate price-enabled Portal configuration, used only for checked upgrade confirmation.
STRIPE_UPGRADE_PORTAL_CONFIGURATION_ID=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_LIVE_CHECKOUT_ENABLED=false

# Cloudflare R2 using S3 credentials; use separate buckets per environment.
# Runtime credentials: Object Read & Write scoped to BOTH buckets.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# US jurisdiction: https://<32-hex-account-id>.us.r2.cloudflarestorage.com
# Default jurisdiction: https://<32-hex-account-id>.r2.cloudflarestorage.com
# Both buckets must belong to the selected endpoint's account and jurisdiction.
S3_API_ENDPOINT=
# Public bucket: immutable composed share cards only.
S3_BUCKET_NAME=
# Required DIFFERENT bucket: uploaded backgrounds and logos.
# Keep public access disabled; it never falls back to S3_BUCKET_NAME.
S3_PRIVATE_BUCKET_NAME=
# Public card delivery origin; never the S3 API endpoint.
# A bucket's https://pub-<id>.r2.dev URL is suitable for development only.
# Connect a custom domain to the public bucket before production launch.
S3_PUBLIC_URL=
# Optional when the endpoint above contains the account ID; must match if set.
R2_ACCOUNT_ID=
# Existing R2 names remain supported and nonempty values take precedence per setting:
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_PUBLIC_BUCKET=
# R2_PRIVATE_BUCKET=
# R2_PUBLIC_URL=
# SDK region is always auto. See docs/PRODUCTION.md for provisioning and CORS.
