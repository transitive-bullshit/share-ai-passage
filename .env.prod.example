# Copy to .env.prod.local for explicit *:prod commands only.
# These commands use real production data; normal pnpm dev stays local.
# Enter complete values; do not use variable references such as $DATABASE_URL.

# Production runtime connection, normally Neon's pooled URL with sslmode=require.
DATABASE_URL=
# Direct connection to the same production database, used only for migrations.
DIRECT_DATABASE_URL=

# Stable production secret: generate at least 32 random characters.
APP_SECRET=

# Production preview generation credentials and model.
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-nano
OPENAI_API_KEY=

# PORT, NODE_ENV and deployment/proxy settings are controlled by the wrapper.
# Local origin: http://localhost:3001 (override with --port on app commands).
# Use the same --port for build:prod and start:prod.

# Accounts: defaults use APP_SECRET and the resolved application origin.
# Keep the auth secret stable; rotating it invalidates sessions.
BETTER_AUTH_SECRET=
# For *:prod commands, omit this or match http://localhost:<selected port>.
BETTER_AUTH_URL=

# Use separate development and production OAuth apps/projects.
# Development Google sign-in uses owned-domain HTTPS; see docs/PRODUCTION.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email/password signup and recovery use the verified accounts sending domain.
# Use a separate Sending-access key restricted to this domain per environment.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Passage <hello@accounts.share-ai-passage.com>"
# Optional reply address for account messages.
RESEND_REPLY_TO="passage@transitivebullsh.it"

# Paid plans: separate Stripe sandbox/live credentials and prices per environment.
# Test checkout works when configured. Keep live checkout disabled until Gate B.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_IMAGE_PACK_PRICE_ID=
STRIPE_LIVE_CHECKOUT_ENABLED=false

# R2: private uploads/references/generated artwork; public composed share cards.
# Use separate environment buckets and bucket-scoped Object Read & Write credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=
# Optional jurisdiction endpoint on this account's r2.cloudflarestorage.com domain.
R2_ENDPOINT=

# Images use OPENAI_API_KEY. New work stays disabled pending quality/cost validation.
# Existing accepted jobs finish using their persisted model configuration.
IMAGE_AI_MODEL=gpt-image-2.5-flare-2026-09-08
IMAGE_GENERATION_ENABLED=0
# Required explicit positive USD monthly operational budget before enabling images.
# It reserves estimated liability; it is not a provider-enforced spending cap.
IMAGE_AI_MONTHLY_BUDGET_USD=
IMAGE_GENERATION_CONCURRENCY=4
