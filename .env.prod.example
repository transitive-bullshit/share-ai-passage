# Copy to .env.prod.local for explicit *:prod commands only.
# These commands use real production data; normal pnpm dev stays local.
# Values are literal; variable references such as $DATABASE_URL are not expanded.

# Production runtime connection, normally Neon's pooled URL with sslmode=require.
DATABASE_URL=
# Direct connection to the same production database, used only for migrations.
DIRECT_DATABASE_URL=

# Stable production secret: generate at least 32 random characters.
APP_SECRET=

# Production preview generation credentials and model.
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-nano
OPENAI_API_KEY=

# Cloudflare R2: use object read/write credentials scoped to both buckets.
# The API endpoint must match the account and bucket jurisdiction.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_API_ENDPOINT=
S3_BUCKET_NAME=passage
S3_PRIVATE_BUCKET_NAME=passage-private
S3_PUBLIC_URL=https://passage.cultural-alignment.com

# PORT, NODE_ENV and deployment/proxy settings are controlled by the wrapper.
# Local origin: http://localhost:3001 (override with --port on app commands).
# Use the same --port for build:prod and start:prod.

# Provisioned for future account-email integration; not yet consumed by the app.
# Use a separate Sending-access key restricted to the accounts subdomain per environment.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Passage <hello@accounts.share-ai-passage.com>"
RESEND_REPLY_TO="passage@transitivebullsh.it"

# Provisioned for future GitHub sign-in integration; not yet consumed by the app.
# Use separate development and production OAuth apps; see docs/PRODUCTION.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google sign-in integration is pending; use separate OAuth projects per environment.
# Only production credentials have been provisioned; see docs/PRODUCTION.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
