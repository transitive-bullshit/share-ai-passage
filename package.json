{
  "name": "ai-chat-proxy",
  "version": "0.0.0",
  "private": true,
  "description": "Public AI conversations, saved with concise highlights and a beautiful share card",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": "https://github.com/transitive-bullshit/ai-chat-proxy",
  "type": "module",
  "scripts": {
    "predev": "pnpm fonts:prepare",
    "dev": "portless run next dev --hostname 127.0.0.1",
    "prebuild": "pnpm fonts:prepare",
    "build": "next build --webpack",
    "start": "next start",
    "share": "node .agents/skills/passage-share/scripts/passage.mjs",
    "lint": "oxlint",
    "test": "run-s test:*",
    "test:format": "oxfmt --check",
    "test:lint": "oxlint",
    "test:types": "next typegen && tsc --noEmit",
    "test:unit": "pnpm fonts:prepare && vitest run",
    "typecheck": "pnpm test:types",
    "fix": "run-s fix:*",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "fonts:prepare": "tsx scripts/prepare-fonts.ts",
    "fixtures:summary": "tsx scripts/regenerate-summary-fixture.ts",
    "db:local": "tsx scripts/db-local.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:removal": "tsx scripts/smoke-removal.ts",
    "dev:prod": "node --import tsx scripts/production.ts dev",
    "build:prod": "node --import tsx scripts/production.ts build",
    "start:prod": "node --import tsx scripts/production.ts start",
    "db:migrate:prod": "node --import tsx scripts/production.ts migrate",
    "db:check:prod": "node --import tsx scripts/production.ts check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.50",
    "@ai-sdk/openai": "^4.0.62",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/noto-emoji": "^5.3.1",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@next/env": "^16.3.4",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.94",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.43.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.3.4",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "satori": "^0.33.4",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@fisch0920/config": "^2.1.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.10",
    "lint-staged": "^17.5.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "portless": "^0.15.6",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
